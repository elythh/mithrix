{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "prHourlyLimit": 0,
  "extends": ["config:recommended"],
  "timezone": "Europe/Berlin",
  "reviewers": ["meadow"],
  "gitIgnoredAuthors": ["195547385+meadow[bot]@users.noreply.github.com"],
  "lockFileMaintenance": { 
    "enabled": true,
    "schedule": ["* 0-3 * * 0"],
    "automergeType": "branch"
  },
  "nix": {
    "enabled": true
  },
  "platformAutomerge": true,
  "automerge": true,
  "automergeType": "pr",
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true,
      "automergeType": "branch"
    },
    {
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "automergeType": "pr"
    }
  ]
}
